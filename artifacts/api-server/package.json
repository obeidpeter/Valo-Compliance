{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:valo": "tsx --test src/lib/valo-validation.test.ts src/lib/valo-quota.test.ts src/lib/valo-render.test.ts src/lib/valo-customer-ai.test.ts src/lib/valo-site-origin.test.ts src/lib/valo-catalogue.test.ts",
    "test:valo-security-http":"tsx --test src/lib/valo-proxy-security.test.ts",
    "test:valo-write-security":"NODE_ENV=development tsx --test src/lib/valo-write-security.integration.test.ts",
    "test:valo-exports": "tsx --test src/lib/valo-exports.integration.test.ts",
    "test:valo-db": "NODE_ENV=development tsx --test src/lib/valo-store.integration.test.ts src/lib/valo-quota.integration.test.ts src/lib/valo-requirements.integration.test.ts src/lib/valo-customer-ai.integration.test.ts src/lib/valo-customer-access.integration.test.ts",
    "test:valo-http": "tsx --test src/lib/valo-http.test.ts",
    "worker:dev": "NODE_ENV=development tsx src/workers/export-worker.ts",
    "queue:generate": "tsx src/scripts/queue-migration.ts generate",
    "sources:retrieve-development": "NODE_ENV=development tsx src/scripts/retrieve-sources.ts",
    "sources:retrieve-instruments": "tsx src/scripts/retrieve-instruments.ts",
    "editorial:proof-development": "tsx src/scripts/editorial-proof.ts",
    "test:valo-editorial": "tsx --test src/editorial/pipeline-contract.test.ts src/editorial/citation-selection.test.ts",
    "test:valo-publication": "tsx --test src/editorial/operational-publication.integration.test.ts",
    "test:valo-editorial-proof": "tsx --test src/editorial/pipeline-proof.integration.test.ts",
    "test:valo-customer-journey": "tsx src/scripts/p0-customer-journey.ts",
    "test:valo-sources": "tsx --test src/editorial/source-controls.test.ts",
    "test:valo-source-db": "tsx --test src/editorial/source-store.integration.test.ts",
    "queue:apply-development": "tsx src/scripts/queue-migration.ts apply-development"
  },
  "dependencies": {
    "@clerk/express": "^2.1.88",
    "@clerk/shared": "^4.44.1",
    "@opentelemetry/api": "1.10.0",
    "@replit/object-storage": "1.0.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "@workspace/valo-core": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "9.15.3",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "pg-boss": "12.38.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "playwright": "1.65.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.55",
    "@playwright/test": "1.65.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "fflate": "0.8.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
