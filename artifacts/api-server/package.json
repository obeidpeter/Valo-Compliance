{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:valo": "tsx --test src/lib/valo-validation.test.ts src/lib/valo-quota.test.ts",
    "test:valo-db": "tsx --test src/lib/valo-store.integration.test.ts src/lib/valo-quota.integration.test.ts",
    "test:valo-http": "tsx --test src/lib/valo-http.test.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.88",
    "@clerk/shared": "^4.44.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/valo-core": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
