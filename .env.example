# Generated by `pnpm --filter @workspace/api-server settings:env-example`. Do not edit by hand.
# Never commit real values. Secrets belong in the server secret store.

# --- Runtime ---
# `development` enables development-only features. `production` serves only GET /api/healthz (private rehearsal).
NODE_ENV=development
# Any non-empty value disables development-only features. Set by Replit deployments.
# REPLIT_DEPLOYMENT=
# Workspace preview domain; the default trusted origin in development. Set by Replit workspace.
# REPLIT_DEV_DOMAIN=
# HTTP port the API listens on.
PORT=8080
# pino log level.
LOG_LEVEL=info
# Set to 1 for human-readable development logs.
VALO_PRETTY_LOGS=
# Path prefix the web app is served under.
BASE_PATH=/
# The API's address on this machine for the web server's page renders, plain http to loopback or https (read by the web app). Unset, they use the configured public origin; dev:compiled sets http://127.0.0.1:8080.
VALO_API_INTERNAL_ORIGIN=http://127.0.0.1:8080
# `compiled` marks the compiled development site, which the Replit workspace's preview may show (read by the web app). Ignored in a deployment. Set by the web app's dev:compiled command.
# VALO_DEVELOPMENT_SITE=

# --- Identity and request security ---
# Clerk backend key. Secret.
CLERK_SECRET_KEY=
# Clerk publishable key (also used by the web app).
CLERK_PUBLISHABLE_KEY=
# At least 32 characters. Keys rate-limit pseudonyms, the default privacy signing key and the recovery journal MAC. Secret.
SESSION_SECRET=
# JSON keyring of current and historical privacy signing keys, for key rotation. Secret.
VALO_PRIVACY_KEYRING=
# Exact origin (scheme, host, port) allowed to send writes. Writes return 503 when unset.
VALO_TRUSTED_ORIGIN=https://valo.example
# Comma-separated CIDRs of reverse proxies whose forwarding headers are trusted.
VALO_TRUSTED_PROXY_CIDRS=
# Clerk proxy URL for the web app.
CLERK_PROXY_URL=

# --- Request limits ---
# Support requests from people not signed in, from one contact address a minute (1-10000, default 3).
VALO_LIMIT_PUBLIC_SUPPORT=3
# Support requests from people not signed in, from one contact address a day (1-10000, default 20).
VALO_LIMIT_PUBLIC_SUPPORT_DAY=20
# Support requests from people not signed in, from one network address a minute (1-10000, default 20).
VALO_LIMIT_PUBLIC_SUPPORT_SOCKET=20
# Support requests from people not signed in, from one network address a day (1-10000, default 100).
VALO_LIMIT_PUBLIC_SUPPORT_SOCKET_DAY=100
# Support requests from people not signed in, from everyone together a minute (1-10000, default 100).
VALO_LIMIT_PUBLIC_SUPPORT_ALL=100
# Support requests from people not signed in, from everyone together a day (1-10000, default 1000).
VALO_LIMIT_PUBLIC_SUPPORT_ALL_DAY=1000
# Reads by one visitor or address not signed in, a minute (1-10000, default 60).
VALO_LIMIT_ANONYMOUS_READ=60
# Reads by one signed-in account a minute (1-10000, default 120).
VALO_LIMIT_AUTHENTICATED_READ=120
# Reads by every page the web server renders, for all visitors together, a minute (1-10000, default 600).
VALO_LIMIT_PAGE_RENDER_READ=600
# Drafting assistant requests by one account a minute (1-10000, default 5).
VALO_LIMIT_CUSTOMER_AI=5
# Checkouts begun by one account a minute (1-10000, default 10).
VALO_LIMIT_CHECKOUT_CREATE=10
# Checkouts begun by one account a day (1-10000, default 100).
VALO_LIMIT_CHECKOUT_CREATE_DAY=100
# Files one account asks Valo to make a minute: document exports and receipt files (1-10000, default 10).
VALO_LIMIT_EXPORT_CREATE=10
# Business profile changes by one account a minute (1-10000, default 20).
VALO_LIMIT_PROFILE_WRITE=20
# Business profile changes by one account a day (1-10000, default 200).
VALO_LIMIT_PROFILE_WRITE_DAY=200
# Document changes by one account a minute (1-10000, default 30).
VALO_LIMIT_DOCUMENT_WRITE=30
# Document changes by one account a day (1-10000, default 600).
VALO_LIMIT_DOCUMENT_WRITE_DAY=600
# Support messages by one signed-in customer a minute (1-10000, default 3).
VALO_LIMIT_SUPPORT_WRITE=3
# Support messages by one signed-in customer a day (1-10000, default 20).
VALO_LIMIT_SUPPORT_WRITE_DAY=20
# Support actions by one member of staff a minute (1-10000, default 20).
VALO_LIMIT_STAFF_SUPPORT_WRITE=20
# Support actions by one member of staff a day (1-10000, default 200).
VALO_LIMIT_STAFF_SUPPORT_WRITE_DAY=200
# Refund requests by one account a minute (1-10000, default 10).
VALO_LIMIT_REFUND_CREATE=10
# Refund requests by one account a day (1-10000, default 50).
VALO_LIMIT_REFUND_CREATE_DAY=50

# --- Database ---
# PostgreSQL connection string. Secret.
DATABASE_URL=
# The same database, logged in as valo_workspace_login, for customer requests and the worker's jobs for one workspace (read by lib/db; lib/db/scripts/workspace-login.mjs prints it). Direct or through a session pooler, not a transaction pooler. Both fail while it is unset. Secret.
VALO_CUSTOMER_DATABASE_URL=
# Maximum application PostgreSQL pool connections per process (1-100, default 10; read by lib/db).
VALO_DB_POOL_MAX=10
# Maximum workspace-scoped PostgreSQL pool connections per process (1-100, default 10; read by lib/db).
VALO_CUSTOMER_DB_POOL_MAX=10
# Password lib/db/scripts/workspace-login.mjs gives valo_workspace_login when an operator enables it; at least 24 printable ASCII characters. The application never reads it. Secret.
VALO_WORKSPACE_LOGIN_PASSWORD=
# The same database, logged in as valo_publisher_login, for releasing a content version (read by lib/db; lib/db/scripts/publisher-login.mjs prints it). The database publishes a version only in a session that logged in as this login, so a release fails while it is unset. Give it only to the process that publishes. Secret.
VALO_PUBLISHER_DATABASE_URL=
# Password lib/db/scripts/publisher-login.mjs gives valo_publisher_login when an operator enables it; at least 24 printable ASCII characters. The application never reads it. Secret.
VALO_PUBLISHER_LOGIN_PASSWORD=
# The same database, logged in as valo_drafter_login, for adding a content version or a prepared candidate (read by lib/db; lib/db/scripts/drafter-login.mjs prints it). The database adds content only in a session that logged in as this login, so preparing a candidate fails while it is unset. Give it only to the commands that prepare and to the worker, never to the API. Secret.
VALO_DRAFTER_DATABASE_URL=
# Password lib/db/scripts/drafter-login.mjs gives valo_drafter_login when an operator enables it; at least 24 printable ASCII characters. The application never reads it. Secret.
VALO_DRAFTER_LOGIN_PASSWORD=
# The same database, logged in as valo_reviewer_login, for recording an AI review's attempt (read by lib/db; lib/db/scripts/reviewer-login.mjs prints it). The database records a review's attempt only in a session that logged in as this login, so a review fails while it is unset. Give it only to the commands that run reviews, never to the API or the worker. Secret.
VALO_REVIEWER_DATABASE_URL=
# Password lib/db/scripts/reviewer-login.mjs gives valo_reviewer_login when an operator enables it; at least 24 printable ASCII characters. The application never reads it. Secret.
VALO_REVIEWER_LOGIN_PASSWORD=

# --- Files and exports ---
# Replit App Storage private directory for development exports.
PRIVATE_OBJECT_DIR=
# Separate, non-overlapping private directory for the production rehearsal.
VALO_PRODUCTION_PRIVATE_OBJECT_DIR=
# Chromium used to render PDFs.
CHROMIUM_EXECUTABLE_PATH=/repl/tools/bin/chromium
# Days a generated export stays downloadable (1-365).
VALO_EXPORT_RETENTION_DAYS=30

# --- Payments (test mode only) ---
# Paystack key. Must start with sk_test_; live keys are refused. Secret.
PAYSTACK_SECRET_KEY=
# `timestamped` or `legacy` webhook signature mode.
PAYSTACK_WEBHOOK_MODE=
# Secret for timestamped webhook signatures. Secret.
PAYSTACK_WEBHOOK_SECRET=
# `true` enables test-mode checkout and webhooks in development.
VALO_SANDBOX_CHECKOUT_ENABLED=false
# `true` enables test-mode refunds.
VALO_SANDBOX_REFUNDS_ENABLED=false
# `true` enables test-mode dispute actions.
VALO_SANDBOX_DISPUTES_ENABLED=false

# --- AI ---
# Must be `false` in the production rehearsal. Customer AI otherwise runs only inside an owner-approved finite budget context.
VALO_CUSTOMER_AI_ENABLED=false
# Replit AI Integrations base URL (read by lib/integrations-openai-ai-server).
AI_INTEGRATIONS_OPENAI_BASE_URL=
# Replit AI Integrations key (read by lib/integrations-openai-ai-server). Secret.
AI_INTEGRATIONS_OPENAI_API_KEY=

# --- Email ---
# `development-test` enables the single-recipient test mailer.
VALO_EMAIL_MODE=
# `development-test` lets the reminder worker send through the test mailer.
VALO_EMAIL_OUTBOX_ENABLED=
# Verified sender address for test email.
VALO_EMAIL_FROM=
# The only recipient test email may reach; must match the user's verified address.
VALO_EMAIL_TEST_RECIPIENT=
# The email service's signing secret for its delivery reports (`whsec_…`; several separated by commas while one is replaced). Unset, POST /api/webhooks/email answers that it is not set up. Development only. Secret.
VALO_EMAIL_WEBHOOK_SECRET=
# `stand-in` lets the worker hand each message Valo owes, such as a receipt, to the stand-in, which sends nothing. Unset, every message waits. Refused in production.
VALO_MESSAGE_SENDER=

# --- Worker and monitoring ---
# Loopback port for the worker's /healthz and /readyz.
VALO_WORKER_HEALTH_PORT=
# `ipc-v1` when the worker runs under the supervisor. Set by export supervisor.
# VALO_SUPERVISED_WORKER=
# Must be `replit-reserved-vm-same-app` for the production rehearsal.
VALO_WORKER_TOPOLOGY=
# Number of worker processes (the rehearsal requires 1).
VALO_WORKER_REPLICAS=
# Concurrent document export jobs per worker (1-5). Bounded by VALO_DB_POOL_MAX minus reserved operational slots.
VALO_EXPORT_CONCURRENCY=1
# `healthchecks` enables external heartbeat pings.
VALO_EXTERNAL_MONITORING=
# Healthchecks ping URL for the worker. Secret.
VALO_WORKER_MONITOR_URL=
# Healthchecks ping URL for operations alerts. Secret.
VALO_OPERATIONS_MONITOR_URL=
# Web app port; must differ from the API and worker health ports.
VALO_FRONTEND_PORT=

# --- Production rehearsal ---
# `private-rehearsal-v1` to start API and worker in the private production rehearsal.
VALO_RUNTIME_ACTIVATION=
# Commit the release manifest was built from.
VALO_RELEASE_SHA=
# Expected instance UUID in the rehearsal database's valo_runtime_identity row.
VALO_PRODUCTION_DATABASE_ID=
# `approved-empty-rehearsal` for the one-time bootstrap of an empty rehearsal database.
VALO_EMPTY_DATABASE_BOOTSTRAP=

# --- Recovery ---
# Set during isolated recovery drills; any value blocks Paystack and email effects.
VALO_ISOLATED_RECOVERY=
# Restore root for the separate-host (Windows) recovery replay.
VALO_RECOVERY_WINDOWS_ROOT=

# --- Editorial ---
# `recorded` reuses the recorded original authoring run instead of new drafting.
VALO_OPERATIONAL_AUTHORING=
# Private development directory for operator-retained NDPC PDFs and their dated official retrieval receipts.
VALO_MANUAL_OFFICIAL_CAPTURE_DIR=
# Separately prepared genuine-evidence seed database that editorial lifecycle cases clone into a disposable database (development only). Secret.
VALO_EDITORIAL_LIFECYCLE_DATABASE_URL=
# The lifecycle seed database's server, logged in as valo_publisher_login. A lifecycle case that releases a version does so on its disposable copy through this login; without it such a case fails as the publisher login is unavailable (development only). Secret.
VALO_EDITORIAL_LIFECYCLE_PUBLISHER_DATABASE_URL=
# `official-development-only` to run the development editorial proof.
VALO_RUN_EDITORIAL_PROOF=

# --- Operator commands ---
# `read-only` to run the legacy export retention inventory.
VALO_RETENTION_INSPECTION=
# Opt-in for the production storage isolation probe.
VALO_PRODUCTION_STORAGE_PROBE=
# `first-system-administrator` to confirm the one-time first administrator bootstrap.
VALO_STAFF_BOOTSTRAP=
# Opt-in for the external monitoring delivery probe.
VALO_MONITORING_PROBE=
